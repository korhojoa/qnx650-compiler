+        pub type msgqnum_t = u32;
+        pub type msglen_t = u32;
+        pub type fsblkcnt_t = u32;
+        pub type fsfilcnt_t = u32;
+        pub type rlim_t = u32;
+        // ...but the LFS (`*64`) surface is fully present in libc.so.3, and
+        // it is the ONLY way to reach a large file: `off_t` above is i32, so
+        // `lseek`/`ftruncate`/`pread`/`pwrite` cannot express such an offset,
+        // and `stat`/`fstat`/`lstat` fail outright with EOVERFLOW on a big
+        // file rather than filling in the `_hi` words (measured on the ARM
+        // hardware).
+        // <sys/target_nto.h>: __OFF64_T=_Int64t, __INO64_T/__BLKCNT64_T=_Uint64t.
+        pub type off64_t = i64;
+        pub type ino64_t = u64;
+        pub type blkcnt64_t = u64;
+        // <spawn.h>: both are _Uintptrt (opaque), unlike QNX 7.
+        pub type posix_spawn_file_actions_t = crate::uintptr_t;
+        pub type posix_spawnattr_t = crate::uintptr_t;
+    } else {
+        pub type ino_t = u64;
+        pub type off_t = i64;
+        pub type blkcnt_t = u64;
+        pub type msgqnum_t = u64;
+        pub type msglen_t = u64;
+        pub type fsblkcnt_t = u64;
+        pub type fsfilcnt_t = u64;
+        pub type rlim_t = u64;
+        pub type posix_spawn_file_actions_t = *mut c_void;
+        pub type posix_spawnattr_t = crate::uintptr_t;
+    }
+}

