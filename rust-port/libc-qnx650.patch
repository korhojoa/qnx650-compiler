+        pub edi: u32,
+        pub esi: u32,
+        pub ebp: u32,
+        pub exx: u32,
+        pub ebx: u32,
+        pub edx: u32,
+        pub ecx: u32,
+        pub eax: u32,
+        pub eip: u32,
+        pub cs: u32,
