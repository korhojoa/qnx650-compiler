new file mode 100644
index 00000000..10e419d0
--- /dev/null
+++ b/src/unix/nto/arch/arm.rs
@@ -0,0 +1,32 @@
+//! Definitions specific to QNX 6.5 on ARMv7.
+
+use crate::prelude::*;
+
+pub type wchar_t = u32;
+pub type time_t = u32;
+
+s! {
+    pub struct arm_cpu_registers {
+        pub gpr: [u32; 16],
+        pub spsr: u32,
+    }
+
+    pub struct arm_vfp_registers {
+        pub x: [u64; 32],
+        pub fpscr: u32,
+        pub fpexc: u32,
+        pub fpinst: u32,
+        pub fpinst2: u32,
+    }
+
+    pub struct mcontext_t {
+        pub cpu: crate::arm_cpu_registers,
+        pub fpu: crate::arm_vfp_registers,
+    }
+
+    pub struct stack_t {
+        pub ss_sp: *mut c_void,
+        pub ss_size: size_t,
+        pub ss_flags: c_int,
+    }
+}
