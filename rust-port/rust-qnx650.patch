diff --git a/compiler/rustc_target/src/spec/targets/armv7_unknown_nto_qnx650.rs b/compiler/rustc_target/src/spec/targets/armv7_unknown_nto_qnx650.rs
new file mode 100644
index 00000000..12fff747
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/armv7_unknown_nto_qnx650.rs
@@ -0,0 +1,33 @@
+use crate::spec::{Abi, Arch, Env, FloatAbi, Target, TargetOptions, base};
+
+// ARMv7-A QNX Neutrino 6.5.0 (Cortex-A9 class hardware, strict alignment).
+//
+// - soft-float *call* ABI: link-compatible with the platform's softfp C
+//   libraries (both pass floats in core registers); VFP compute can be
+//   enabled later by adding vfp features while keeping FloatAbi::Soft.
+// - +strict-align is mandatory: these kernels run with SCTLR.A=1 and any
+//   unaligned LDR/STR is a SIGBUS.
+// - Links through the arm-unknown-nto-qnx6.5.0eabi GCC cross driver, never
+//   qcc 4.4 (the driver's specs inject exidx-merge.ld, without which the
+//   in-libc EABI unwinder sees no unwind tables and every panic aborts).
+
+pub(crate) fn target() -> Target {
+    let mut meta = base::nto_qnx::meta();
+    meta.description = Some("Armv7-A QNX Neutrino 6.5.0 RTOS".into());
+    meta.std = Some(true);
+    Target {
+        llvm_target: "armv7-unknown-unknown-eabi".into(),
+        metadata: meta,
+        pointer_width: 32,
+        data_layout: "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64".into(),
+        arch: Arch::Arm,
+        options: TargetOptions {
+            abi: Abi::Eabi,
+            llvm_floatabi: Some(FloatAbi::Soft),
+            features: "+v7,+thumb2,+soft-float,+strict-align,-neon".into(),
+            max_atomic_width: Some(64),
+            env: Env::Nto65,
+            ..base::nto_qnx::opts65("arm-unknown-nto-qnx6.5.0eabi-gcc")
+        },
+    }
+}
diff --git a/compiler/rustc_target/src/spec/targets/i586_pc_nto_qnx650.rs b/compiler/rustc_target/src/spec/targets/i586_pc_nto_qnx650.rs
new file mode 100644
index 00000000..4a43bbbe
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/i586_pc_nto_qnx650.rs
@@ -0,0 +1,34 @@
+use crate::spec::{Arch, Env, PanicStrategy, RustcAbi, StackProbeType, Target, TargetOptions, base};
+
+// 32-bit x86 QNX Neutrino 6.5.0 -- the fast-iteration testbed twin of
+// armv7-unknown-nto-qnx650-eabi (std development happens against a real
+// x86 QNX 6.5 machine over ssh).
+//
+// panic=abort is hardwired: throwing through QNX 6.5's x86 DWARF EH is
+// known-broken (aborts in the terminate path), so unwinding is only
+// supported on the ARM (EHABI) target.
+
+pub(crate) fn target() -> Target {
+    let mut meta = base::nto_qnx::meta();
+    meta.description = Some("32-bit x86 QNX Neutrino 6.5.0 RTOS".into());
+    meta.std = Some(true);
+    Target {
+        llvm_target: "i586-pc-unknown".into(),
+        metadata: meta,
+        pointer_width: 32,
+        data_layout: "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-\
+            i128:128-f64:32:64-f80:32-n8:16:32-S128"
+            .into(),
+        arch: Arch::X86,
+        options: TargetOptions {
+            rustc_abi: Some(RustcAbi::X86Sse2),
+            cpu: "pentium4".into(),
+            max_atomic_width: Some(64),
+            env: Env::Nto65,
+            vendor: "pc".into(),
+            stack_probes: StackProbeType::Inline,
+            panic_strategy: PanicStrategy::Abort,
+            ..base::nto_qnx::opts65("i386-pc-nto-qnx6.5.0-gcc")
+        },
+    }
+}
