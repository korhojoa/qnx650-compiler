index 00000000000..16e54b7d9ae
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/i586_pc_nto_qnx650.rs
@@ -0,0 +1,34 @@
+use crate::spec::{Arch, Env, PanicStrategy, RustcAbi, StackProbeType, Target, TargetOptions, base};
+
+// 32-bit x86 QNX Neutrino 6.5.0 -- the fast-iteration testbed twin of
+// armv7-unknown-nto-qnx650-eabi (std development happens against a real
+// x86 QNX 6.5 machine over ssh).
+//
+// panic=abort is hardwired: throwing through QNX 6.5's x86 DWARF EH is
+// known-broken (aborts in the terminate path), so unwinding is only
+// supported on the ARM (EHABI) target.
+
+pub(crate) fn target() -> Target {
+    let mut meta = base::qnx_sdp::meta();
+    meta.description = Some("32-bit x86 QNX Neutrino 6.5.0 RTOS".into());
+    meta.std = Some(true);
+    Target {
+        llvm_target: "i586-pc-unknown".into(),
+        metadata: meta,
+        pointer_width: 32,
+        data_layout: "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-\
+            i128:128-f64:32:64-f80:32-n8:16:32-S128"
+            .into(),
+        arch: Arch::X86,
+        options: TargetOptions {
+            rustc_abi: Some(RustcAbi::X86Sse2),
+            cpu: "pentium4".into(),
+            max_atomic_width: Some(64),
+            env: Env::Nto65,
+            vendor: "pc".into(),
+            stack_probes: StackProbeType::Inline,
+            panic_strategy: PanicStrategy::Abort,
+            ..base::qnx_sdp::opts65("i386-pc-nto-qnx6.5.0-gcc")
+        },
+    }
+}
