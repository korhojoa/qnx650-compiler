--- a/libgcc/config/arm/t-nto
+++ b/libgcc/config/arm/t-nto
@@ -0,0 +1,21 @@
+CRTSTUFF_T_CFLAGS = -fno-omit-frame-pointer $(PICFLAG) -DCRTSTUFFS_O
+SHLIB_LDFLAGS = -Wl,--soname=$(SHLIB_SONAME)
+
+# QNX 6.5: libgcc.a must contain the ARM EABI helpers (__aeabi_uidiv,
+# __aeabi_idiv, __aeabi_uldivmod and more), as the SDP GCC 4.4.2 libgcc.a
+# does. libc.so.3 exports them. libc.a only calls them, thus a -static
+# link has no other definition. lib1funcs.S has no L_dvmd_nto section.
+# _dvmd_tls gives the weak __aeabi_idiv0 and __aeabi_ldiv0 hooks.
+LIB1ASMSRC = arm/lib1funcs.S
+LIB1ASMFUNCS += _udivsi3 _divsi3 _umodsi3 _modsi3 _dvmd_tls _bb_init_func \
+		_call_via_rX _interwork_call_via_rX _lshrdi3 _ashrdi3 \
+		_ashldi3 _clzsi2 _clzdi2  _arm_negdf2 _arm_addsubdf3 \
+		_arm_muldivdf3 _arm_cmpdf2 _arm_unorddf2 _arm_fixdfsi \
+		_arm_fixunsdfsi _arm_truncdfsf2  _arm_negsf2 _arm_addsubsf3 \
+		_arm_muldivsf3  _arm_cmpsf2 _arm_unordsf2 _arm_fixsfsi \
+		_arm_fixunssfsi  _arm_floatdidf _arm_floatdisf \
+		_arm_floatundidf _arm_floatundisf
+
+HOST_LIBGCC2_CFLAGS += -fomit-frame-pointer
+
+LIBGCC2_DEBUG_CFLAGS = -g0
