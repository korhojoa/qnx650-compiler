+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC \
+"%{!shared: %{pg|p:mcrt1.o;:crt1%{pie:S}.o}%s } crti.o%s crtbegin.o%s "
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC \
+"crtend.o%s crtn.o%s"
+
+#undef LINK_SPEC
+#define LINK_SPEC \
+"%{h*} %{v:-V} \
+ %{b} %{Wl,*:%*} \
+ %{!r:--build-id=md5} \
+ --warn-shared-textrel \
+ " QNX_RELRO_SPEC " \
+ %{static:-Bstatic} \
+ %{shared} \
+ %{symbolic:-Bsymbolic} \
+ %{G:-G} %{MAP:-Map mapfile} \
+ %{!shared: \
+   %{!static: \
+     %{rdynamic:-export-dynamic}} \
